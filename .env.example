# Copy to .env.local for local tooling (Prisma CLI, seed). Never commit real values.
# Neon pooled connection string (app runtime) — `neon env pull` fills this in.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon direct connection (schema changes: prisma db push)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
# /admin login password
ADMIN_PASSWORD="change-me"
# 32+ random chars used to sign the admin session cookie
ADMIN_SESSION_SECRET="generate-a-long-random-string"
