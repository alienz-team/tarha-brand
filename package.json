{
  "name": "tarha-brand",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mts",
    "db:studio": "prisma studio",
    "preview": "node scripts/build-worker.mjs && opennextjs-cloudflare preview",
    "deploy": "node scripts/build-worker.mjs && opennextjs-cloudflare deploy",
    "upload": "node scripts/build-worker.mjs && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@neon/config": "^1.14.6",
    "@neon/env": "^2.1.9",
    "@neondatabase/serverless": "^1.2.1",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.18",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "postcss": "^8.5.33",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.166.0"
  }
}
